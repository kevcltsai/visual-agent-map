{
  "name": "visual-agent-map",
  "version": "0.9.2",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "compile:sample": "node scripts/compile-sample.mjs",
    "build": "npm run compile:sample && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "test:vault": "npm run test:vault:onboarding",
    "test:vault:onboarding": "node scripts/create-onboarding-test-vault.mjs --profile=onboarding",
    "test:vault:normal": "node scripts/create-onboarding-test-vault.mjs --profile=normal",
    "test:vault:reinstall": "node scripts/create-onboarding-test-vault.mjs --profile=reinstall",
    "verify:vault:reinstall": "node scripts/verify-reinstall-test-vault.mjs",
    "lint": "eslint .",
    "test": "npm run compile:sample && node tests/run.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "9.39.5",
    "eslint-plugin-depend": "1.3.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "latest",
    "typescript": "^5.7.2"
  }
}
