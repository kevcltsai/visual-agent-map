          "task",
          "contribution",
          "parentTitle"
        ],
        "additionalProperties": false
      }
    },
    "visualReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
