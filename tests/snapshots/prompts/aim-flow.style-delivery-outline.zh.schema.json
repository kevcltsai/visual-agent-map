{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "description": "適合心智圖的一句繁體中文結論，80 字內"
    },
    "detail": {
      "type": "string",
      "description": "完整的繁體中文 Markdown 分析"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "contribution": {
            "type": "string"
          },
          "parentTitle": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "task",
          "contribution",
          "parentTitle"
        ],
        "additionalProperties": false
      }
    },
    "visualReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "formula": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "imageUrl",
          "sourceUrl",
          "description",
          "palette",
          "formula"
        ],
        "additionalProperties": false
      }
    },
    "aim": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "searchTask": {
                "type": "string",
                "description": "Specific web search needed for this section, or empty if already supported."
              },
              "evidenceIds": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Supplied source IDs this section relies on, or null to use all supplied sources."
              },
              "dependencies": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Additional supplied source IDs, or null."
              }
            },
            "required": [
              "heading",
              "purpose",
              "searchTask",
              "evidenceIds",
              "dependencies"
            ],
            "additionalProperties": false
          }
        },
        "evidenceRequestIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Up to 3 exact evidence IDs whose full reports are needed before deciding; empty when the indexes suffice."
        }
      },
      "required": [
        "sections",
        "evidenceRequestIds"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "summary",
    "detail",
    "suggestions",
    "visualReferences",
    "aim"
  ],
  "additionalProperties": false
}
