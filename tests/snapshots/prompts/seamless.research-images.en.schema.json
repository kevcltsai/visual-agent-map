{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "images": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "imageUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "title": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        },
        "required": [
          "imageUrl",
          "sourceUrl",
          "title",
          "license"
        ]
      }
    }
  },
  "required": [
    "images"
  ]
}
