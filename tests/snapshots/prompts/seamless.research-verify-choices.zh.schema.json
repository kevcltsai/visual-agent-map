{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "footnotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "title"
        ]
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sentence": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported"
            ]
          },
          "correction": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "required": [
          "sentence",
          "verdict"
        ]
      }
    },
    "images": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "imageUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "title": {
            "type": "string"
          },
          "license": {
            "type": "string"
          }
        },
        "required": [
          "imageUrl",
          "sourceUrl",
          "title",
          "license"
        ]
      }
    }
  },
  "required": [
    "detail",
    "footnotes",
    "verdicts",
    "images"
  ]
}
